{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "article-to-vertical-video/brief",
  "title": "brief.json — what we are making, decided before any content is written",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "targetSeconds", "platforms", "persona", "theme", "mode", "language"],
  "properties": {
    "type": {
      "description": "Narrative template family (see references/briefs.md)",
      "enum": ["launch-explainer", "news-brief", "case-reel", "tutorial", "opinion", "comparison", "data-story"]
    },
    "targetSeconds": { "type": "integer", "minimum": 15, "maximum": 900 },
    "tier": {
      "description": "Derived from targetSeconds when omitted: xs ≤30, s ≤90, m ≤240, l >240",
      "enum": ["xs", "s", "m", "l"]
    },
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["xhs-3x4", "wechat-3x4", "douyin-9x16", "xhs-9x16"] }
    },
    "shortVersion": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "targetSeconds": { "type": "integer", "minimum": 15, "maximum": 180 },
        "script": { "enum": ["auto-cut", "separate"] }
      }
    },
    "persona": {
      "type": "object", "additionalProperties": false, "required": ["viewpoint"],
      "properties": {
        "viewpoint": { "type": "string", "description": "e.g. 普通用户 / 打工人视角" },
        "voiceStyle": { "type": "string", "description": "TTS style prompt (context text)" },
        "phrasebank": { "type": "string", "description": "key into references/content-guide.md phrasebanks, e.g. worker" }
      }
    },
    "account": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 16 },
        "badge": { "type": "string", "description": "file under project/public/, e.g. badge.png" }
      }
    },
    "theme": { "enum": ["neon", "paper", "editorial"] },
    "mode": { "enum": ["template", "director"] },
    "language": { "enum": ["zh-CN"] },
    "source": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "fetchedAt": { "type": "string" },
        "kind": { "enum": ["url", "html", "text"] }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["grok-cli", "grok-rest", "none"] },
        "allow": { "type": "array", "items": { "enum": ["cover", "hook", "plates", "concept", "broll", "badge"] } }
      }
    },
    "tts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["seed2", "xai", "none"] },
        "speaker": { "type": "string" },
        "rate": { "type": "integer", "minimum": -50, "maximum": 100 },
        "style": { "type": "string" }
      }
    },
    "notes": { "type": "string", "description": "free text from the user (angle, must-haves, taboos)" }
  }
}
